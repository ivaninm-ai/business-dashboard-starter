    ],
    "excluded": [
      "Cancelled"
    ]
  },
  "policies": {
    "dates": {
      "order": "dmy"
    },
    "tasks": [
      {
        "rule": "payment_follow_up",
        "enabled": true,
        "params": {
          "offset_days": 1
        }
      },
      {
        "rule": "follow_up_due",
        "enabled": false,
        "note": "B2C accounts have no follow-up field"
      },
      {
        "rule": "review_account",
        "enabled": false,
        "note": "Shoppers without orders are not reviewed"
      },
      {
        "rule": "review_replenishment",
        "enabled": true
      },
      {
        "rule": "completion_overdue",
        "enabled": true,
        "note": "Prepaid marketplace orders still need delivery confirmation"
      },
      {
        "rule": "completion_due_soon",
        "enabled": true,
        "params": {
          "within_days": 2
        }
      },
      {
        "rule": "unassigned_prospect",
        "enabled": false
      }
    ]
  },
  "meanings": [
    {
      "id": "M1",
      "field": "customers.type",
      "meaning": "All B2C accounts are recorded as Customer; there is no prospect concept.",
      "basis": "documented"
    },
    {
      "id": "M8",
      "field": "sales.amount",
      "meaning": "Booked order value excluding tax; marketplace checkout money is not the seller payout.",
      "basis": "confirmed"
    },
    {
      "id": "M13",
      "field": "stock.reserved",
      "meaning": "Product-level reservations shared across Shopee, Lazada and showroom.",
      "basis": "confirmed"
    }
